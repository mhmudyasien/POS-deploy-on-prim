# Copy to .env (install.sh does it for you and generates passwords)
SITE_NAME=erp.local
# Pin an exact tag for production (check Docker Hub: frappe/erpnext)
ERPNEXT_VERSION=version-15
DB_ROOT_PASSWORD=change-me
ADMIN_PASSWORD=change-me
HTTP_PORT=8080
BACKUP_KEEP_DAYS=14
# Optional off-site copy, e.g. user@hq-server:/srv/backups/branch1
BACKUP_REMOTE=
